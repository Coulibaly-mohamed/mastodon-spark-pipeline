# ---- Mastodon (Préférences > Développement > Nouvelle application, scope "read")
MASTODON_URL=https://mastodon.social
MASTODON_TOKEN=colle_ton_token_ici

# Mode d'ingestion : stream (temps réel) | poll (requêtes régulières, plus robuste)
INGEST_MODE=stream
# Source : public | hashtag
SOURCE=public
# Si SOURCE=hashtag : liste séparée par des virgules (sans #)
HASHTAGS=ai,tech,bigdata,python
POLL_INTERVAL=15

# ---- Kafka
KAFKA_TOPIC=toots

# ---- PostgreSQL
POSTGRES_DB=mastodon
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark

# ---- Spark / Jupyter
JUPYTER_TOKEN=spark
SPARK_DRIVER_MEMORY=2g
# Langue gardée pour le scoring (le modèle est entraîné en anglais)
FILTER_LANG=en
# Fraction de Sentiment140 utilisée pour l'entraînement (1.0 = 1,6 M lignes)
TRAIN_SAMPLE_FRACTION=0.3
